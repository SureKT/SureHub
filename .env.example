# Claude API
ANTHROPIC_API_KEY=your_key_here

# Telegram
TELEGRAM_BOT_TOKEN=your_token_here
TELEGRAM_ALLOWED_USER_IDS=123456789  # tu user ID de Telegram

# App
APP_ENV=local  # local | production
SECRET_KEY=change_this_in_production

# Hora (0-23, local) del digest diario de la inbox de Obsidian
INBOX_DIGEST_HOUR=9

# Database
# local: sqlite:///./surehub.db
# prod:  sqlite:////srv/surehub/data/surehub.db  (volumen Docker en homelab)
DATABASE_URL=sqlite:///./surehub.db

# Telegram mode (polling local, webhook prod)
TELEGRAM_MODE=polling
WEBHOOK_URL=  # solo en prod: https://tudominio.com/bot/webhook

# Obsidian vault — notas del bot (texto/voz) → <vault>/inbox/*.md
# Si mueves el vault: actualizar esta ruta + volumen Docker en homelab + reiniciar bot
# local: ./data/obsidian | prod: /vault (montado desde /srv/obsidian o ruta que uses)
OBSIDIAN_VAULT_PATH=./data/obsidian

# Google Calendar — OAuth web flow (Inbox Fase 2: eventos → Calendar)
# Credenciales en console.cloud.google.com → APIs & Services → Credentials (OAuth Web).
# Autenticación one-time: visita /api/calendar/oauth/init (vía túnel SSH a localhost:8001).
# El token se guarda en SQLite (tabla google_tokens), no en fichero.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/api/calendar/oauth/callback
GOOGLE_CALENDAR_ID=primary

# Whisper (notas de voz; local, no usa API de Claude)
# WHISPER_MODEL=small
# WHISPER_CACHE_DIR=/data/.cache/whisper
# TAG_MODEL=claude-haiku-4-5
# LLM_MODEL=claude-sonnet-4-6
