# Claude API
ANTHROPIC_API_KEY=your_key_here

# Telegram
TELEGRAM_BOT_TOKEN=your_token_here
TELEGRAM_ALLOWED_USER_IDS=123456789  # tu user ID de Telegram

# App
APP_ENV=local  # local | production
SECRET_KEY=change_this_in_production

# Database
# local: sqlite:///./surehub.db
# prod:  postgresql://user:pass@host/surehub
DATABASE_URL=sqlite:///./surehub.db

# Telegram mode (polling local, webhook prod)
TELEGRAM_MODE=polling
WEBHOOK_URL=  # solo en prod: https://tudominio.com/bot/webhook

# ── Spotify ────────────────────────────────────────────────────────────────────
# Crea tu app en https://developer.spotify.com/dashboard
# Añade como Redirect URI: http://localhost:8000/spotify/callback
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:8000/spotify/callback
